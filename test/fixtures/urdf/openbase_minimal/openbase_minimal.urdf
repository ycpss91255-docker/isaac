<?xml version="1.0"?>
<!--
  openbase_minimal: a single-link, single-mesh test fixture for the model
  import GPU integration test (test_model_import.py).

  Copied from the production openbase_minimal.urdf (a base_link-only
  reduction of the full 33-link OpenBase articulation). The production
  model now lives in ycpss91255-docker/robot_model; this fixture keeps
  the GPU import test self-contained.

  Robot name "open_base" is preserved so the prim-hierarchy assertion
  (EXPECTED_ROBOT_NAME) stays stable.
-->
<robot name="open_base">

	<link name="base_link">

		<inertial>
			<mass value="0.07862944645"/>
			<inertia
				ixx="0.00002035985530754"
				ixy="0"
				ixz="0"
				iyy="0.00002035985530754"
				iyz="0"
				izz="0.00003945961663220"
			/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="package://openbase_minimal/mesh/base.stl"/>
			</geometry>
			<material name="base_material">
				<color rgba="1 1 1 1"/>
			</material>
		</visual>
		<collision>
			<geometry>
				<mesh filename="package://openbase_minimal/mesh/base.stl"/>
			</geometry>
		</collision>

	</link>

</robot>
